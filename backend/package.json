    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "mongodb-memory-server": "^10.4.3",
