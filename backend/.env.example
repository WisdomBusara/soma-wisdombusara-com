NODE_ENV=production
PORT=8080

MONGO_URI=mongodb+srv://...

CORS_ORIGIN=https://app.neithlogic.com
COOKIE_SECURE=true
COOKIE_SAMESITE=LAX

JWT_ACCESS_SECRET=change_me_to_64_random_chars
JWT_REFRESH_SECRET=change_me_to_64_random_chars
JWT_ISSUER=wraith-backend

ENCRYPTION_KEY_BASE64=base64_encoded_32_bytes

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_strong_password

PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_CALLBACK_BASE_URL=https://api.neithlogic.com

TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_BASE_URL=https://api.neithlogic.com

# ── Scholarship Intelligence Engine ─────────────────────────────────────────
# The engine is OFF by default. Existing deployments are unaffected until
# SCHOLARSHIP_CRAWLER_ENABLED is set to true.

SCHOLARSHIP_CRAWLER_ENABLED=false
SCHOLARSHIP_CRAWL_CONCURRENCY=4
SCHOLARSHIP_DOMAIN_CONCURRENCY=2
SCHOLARSHIP_REQUEST_DELAY_MS=1200
SCHOLARSHIP_MAX_DEPTH=2
SCHOLARSHIP_REQUEST_TIMEOUT=20000
SCHOLARSHIP_RETRY_LIMIT=3
# cron expression, UTC. Default 02:00 avoids the 04:00/04:20 jobs+tenders runs.
SCHOLARSHIP_CRAWL_INTERVAL=0 2 * * *
SCHOLARSHIP_CLOSING_SOON_DAYS=14
SCHOLARSHIP_MAX_PAGE_BYTES=5000000
SCHOLARSHIP_MAX_TARGETS_PER_RUN=500
SCHOLARSHIP_USER_AGENT=WraithScholarshipBot/1.0 (+https://your-domain.example/bot; respects robots.txt)
# Only disable for domains you own. Crawling is publicly-accessible pages only.
SCHOLARSHIP_RESPECT_ROBOTS=true
# Below this confidence a record will not be presented as OPEN.
SCHOLARSHIP_MIN_CONFIDENCE=0.45

# JS-rendered page fallback. Requires: npm i playwright && npx playwright install chromium
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_TIMEOUT=30000

# AI extraction is OPTIONAL. With AI_EXTRACTION_ENABLED=false the engine still
# performs full rule-based discovery, classification and extraction.
AI_EXTRACTION_ENABLED=false
# anthropic | openai | huggingface | none
AI_PROVIDER=none
AI_MODEL=claude-sonnet-4-6
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT=60000
# Hard ceiling on LLM calls per crawl run — cost blast-radius control.
AI_MAX_CALLS_PER_RUN=200

UNIVERSITY_DISCOVERY_ENABLED=false
# Narrow the rollout without a deploy, e.g. KE,GB,US
UNIVERSITY_DISCOVERY_COUNTRIES=
# Optional external JSON dataset of institutions. No third-party endpoint is
# contacted unless this is set.
UNIVERSITY_DATASET_URL=

# ── Scholarship site: paywall + ads ─────────────────────────────────────────
# Full detail views a reader gets free each calendar month before the paywall.
# Listings and search are never gated.
SCHOLARSHIP_FREE_VIEWS_PER_MONTH=5
SCHOLARSHIP_SITE_URL=https://scholarships.neithlogic.com

# Ads are shown to free readers only; premium removes them. Set false to run
# the site ad-free entirely.
ADS_ENABLED=true
# Only needed for NETWORK-type ad slots (e.g. AdSense publisher id ca-pub-…).
# HOUSE and CUSTOM ads need nothing here.
ADS_NETWORK_CLIENT_ID=

# Paystack already configured above powers scholarship checkout too — the web
# vertical reuses PAYSTACK_SECRET_KEY and PAYSTACK_CALLBACK_BASE_URL.
