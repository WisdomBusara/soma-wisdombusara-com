    "scholarships:extract": "tsx src/cli/scholarships.ts extract",
    "scholarships:verify": "tsx src/cli/scholarships.ts verify",
    "scholarships:status": "tsx src/cli/scholarships.ts status",
    "scholarships:run": "tsx src/cli/scholarships.ts run",
    "scholarships:reprocess-failed": "tsx src/cli/scholarships.ts reprocess-failed",
    "scholarships:seed-plans": "tsx src/cli/scholarships.ts seed-plans",
